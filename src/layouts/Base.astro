---
import type { TransitionAnimationPair } from 'astro';
import '../styles/global.css';
import '../styles/app.css';
import '../styles/app-jeu.css';
import '../styles/app-ecrans.css';
import Coquille from '../components/Coquille.astro';
import Mesure from '../components/Mesure.astro';
import Recherche from '../components/Recherche.astro';
import { SCRIPT_APPARENCE } from '../lib/apparence';
import { SCRIPT_DEFILEMENT_NAVIGATION } from '../lib/navigation';
import { comptesDeRelecture, versionBanque, cheminBanque } from '../lib/banque';
import { POUR_APP } from '../lib/cible';
import { lienRetour, pageCourante } from '../lib/page';
import {
  SITE,
  APP_STORE,
  titrePage,
  descriptionPage,
  cheminServi,
  filAriane,
  siteWeb,
  graphe,
  type JsonLd,
  type Miette,
} from '../lib/seo';

interface Props {
  titre: string;
  description: string;
  /** Laisser à false sur les écrans de jeu, qui n'ont rien à indexer. */
  indexable?: boolean;
  canonique?: string;
  /** Fil d'Ariane, sans l'accueil : il est ajouté en tête. */
  miettes?: readonly Miette[];
  /**
   * L'échelon du dessus dans l'app seulement, pour une page sans fil
   * d'Ariane qu'on atteint depuis un écran : « À propos » ou « Réglages »,
   * ouverts depuis la fiche. Sur le site, rien ne change.
   */
  retourApp?: Miette;
  /** Nœuds JSON-LD propres à la page, ajoutés au graphe du site. */
  jsonLd?: readonly JsonLd[];
  /**
   * Précharger la banque de questions. À poser sur les écrans qui montent un
   * `Quiz` au premier écran : sans elle, la banque part au quatrième
   * aller-retour, après le HTML, le runtime React et l'exécution du composant.
   */
  prechargeBanque?: boolean;
  /** Image de partage, relative à la racine. */
  image?: string;
  imageAlt?: string;
}

const {
  titre,
  description,
  indexable = true,
  canonique,
  miettes = [],
  retourApp,
  jsonLd = [],
  prechargeBanque = false,
  image = '/partage/le-permis-cotier.png',
  imageAlt = 'Le Permis Côtier — examens blancs au format de l’épreuve',
} = Astro.props;

const base = Astro.site ?? new URL(SITE.domaine);
const url = canonique ?? new URL(cheminServi(Astro.url.pathname), base).href;
const titreComplet = titrePage(titre);
const descriptionCourte = descriptionPage(description);
const imageAbsolue = new URL(image, base).href;

// Le graphe rassemble ce qui vaut pour tout le site et ce qui vaut pour la
// page. Les écrans non indexables n'en portent pas : baliser ce qu'on demande
// aux moteurs d'ignorer ne sert personne.
const noeuds: JsonLd[] = indexable
  ? [
      siteWeb(base),
      ...(miettes.length > 0
        ? [filAriane([{ nom: 'Accueil', chemin: '/' }, ...miettes], base)]
        : []),
      ...jsonLd,
    ]
  : [];

const version = versionBanque();
const annee = new Date().getFullYear();
const relecture = await comptesDeRelecture();

// La section courante, soulignée dans la navigation.
const chemin = Astro.url.pathname;
const courant = (...sections: string[]) => pageCourante(chemin, ...sections);

// Dans l'app, le fil d'Ariane se réduit à l'échelon du dessus.
// Le changement d'écran de l'app : l'ancien disparaît sur-le-champ, le nouveau
// monte en fondu en 140 ms. Le glissement d'avant durait plus d'une demi-seconde
// sous Safari 16 et 17 (pas de View Transitions natives : Astro joue l'ancien
// écran, puis le nouveau, l'un après l'autre) et faisait attendre chaque tap.
// Seule l'opacité bouge ; `prefers-reduced-motion` coupe tout, par la feuille
// d'Astro.
const fondu: TransitionAnimationPair = {
  old: [],
  new: { name: 'astroFadeIn', duration: 140, easing: 'ease-out', fillMode: 'both' },
};
const retour = POUR_APP ? (lienRetour(chemin, miettes) ?? retourApp ?? null) : null;
---

<!doctype html>
<html lang="fr" data-app={POUR_APP ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    {/* `viewport-fit=cover` dans la coquille : la page va jusque sous
        l'encoche et la barre d'accueil, et `app.css` reprend les marges par
        `env(safe-area-inset-*)`. Sur le site, rien à couvrir. */}
    <meta
      name="viewport"
      content={
        POUR_APP
          ? 'width=device-width, initial-scale=1, viewport-fit=cover'
          : 'width=device-width, initial-scale=1'
      }
    />

    {/*
      Ce dont le premier écran a besoin, demandé tout de suite. La police
      est celle du système : rien à précharger.

      La banque partait au quatrième aller-retour : HTML, puis
      `client.js` et `Quiz.js`, puis l'exécution du composant, puis seulement
      le `fetch`. Un aller-retour de moins sur la première question.
    */}
    {prechargeBanque && (
      <link rel="preload" as="fetch" type="application/json" href={cheminBanque()} crossorigin />
    )}

    <title>{titreComplet}</title>
    <meta name="description" content={descriptionCourte} />
    <link rel="canonical" href={url} />
    {!indexable && <meta name="robots" content="noindex, follow" />}
    {indexable && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={descriptionCourte} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imageAbsolue} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titreComplet} />
    <meta name="twitter:description" content={descriptionCourte} />
    <meta name="twitter:image" content={imageAbsolue} />
    <meta name="author" content={SITE.auteur} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191919" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* L'app suit le système et n'a pas de réglage d'apparence : le script
        ne part que sur le site. */}
    {!POUR_APP && (
      <Fragment set:html={`<!-- L'apparence choisie sur la fiche, posée avant le premier rendu. --><script>${SCRIPT_APPARENCE}</script>`} />
    )}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* La bannière de Safari sur iPhone : « Ouvrir » si l'app est installée,
        « Obtenir » sinon. Rien dans la coquille, qui est l'app. */}
    {!POUR_APP && <meta name="apple-itunes-app" content={`app-id=${APP_STORE.id}`} />}

    {/*
      Le manifeste et l'enregistrement du service worker. `@vite-pwa/astro`
      construit `sw.js`, `registerSW.js` et le manifeste, mais ne les pose sur
      aucune page : il retire le plugin `vite-plugin-pwa:build`, celui dont le
      `transformIndexHtml` s'en chargerait dans une application Vite ordinaire.
      Sans ces deux lignes, le service worker était servi en production sans
      qu'aucun navigateur ne l'installe, et le site n'était ni hors ligne ni
      installable. En développement, `devOptions` est à false : les deux
      fichiers n'existent pas, d'où la garde sur la production.

      Rien de tout ceci dans la coquille : `CIBLE=app` coupe la PWA, donc ni
      `sw.js` ni le manifeste ne sont bâtis, et les deux balises pointeraient
      sur des 404. Un service worker par-dessus des fichiers déjà locaux, ce
      serait de toute façon deux caches qui se marchent dessus, dont un périmé.
    */}
    {!POUR_APP && import.meta.env.PROD && (
      <Fragment>
        <link rel="manifest" href="/manifest.webmanifest" />
        <script is:inline defer src="/registerSW.js"></script>
      </Fragment>
    )}

    {noeuds.length > 0 && <script type="application/ld+json" set:html={graphe(noeuds)} is:inline />}

    {/* Le traceur ne part pas dans la coquille : voir `src/lib/cible.ts`. */}
    {!POUR_APP && <Mesure />}
    {/* La navigation sans rechargement, Safari intégré, la barre d'état. */}
    {POUR_APP && <Coquille />}
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>

    {/* Ni en-tête ni pied dans la coquille. Le titre de l'écran, c'est le
        `h1` de la page ; la barre d'onglets native tient la navigation, et
        une barre dessinée en HTML est justement ce que la revue Apple lit
        comme « pas assez différent d'une navigation dans Safari ». La
        recherche a son point d'entrée dans les écrans
        (`OuvrirRecherche.astro`), la version et les licences vivent dans
        `/a-propos`, que la fiche relie. */}
    {!POUR_APP && (
    <header class="entete">
      <div class="page entete__interieur">
        <a href="/" class="marque" aria-label="Permis côtier, accueil">
          {/* Le voyant d'une cardinale, deux cônes opposés par la base, jaunes
              sur le carré d'encre, comme le favicon. Le seul jaune de
              l'en-tête, fixe en clair comme en sombre. */}
          <svg class="marque__glyphe" viewBox="0 0 22 22" width="24" height="24" aria-hidden="true">
            <rect x="0.5" y="0.5" width="21" height="21" rx="4.5" fill="#191918" class="marque__fond" />
            <path d="M11 4.5l4 5.5H7z" fill="#ffc72c" />
            <path d="M11 18l4-5.5H7z" fill="#ffc72c" />
          </svg>
          <span class="marque__nom">Permis côtier</span>
        </a>
        <a
          class="ouvrir-recherche"
          href="/recherche"
          aria-label="Rechercher"
          title="Rechercher (touche /)"
          data-recherche-ouvrir
        >
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="10.5" cy="10.5" r="6.5"></circle>
            <path d="M15.5 15.5 L21 21"></path>
          </svg>
          <span class="ouvrir-recherche__mot">Rechercher</span>
          <kbd class="touche ouvrir-recherche__touche" aria-hidden="true">/</kbd>
        </a>
        <nav aria-label="Navigation principale">
          <a href="/cours" aria-current={courant('/cours')}>Cours</a>
          <a href="/entrainement" aria-current={courant('/entrainement', '/revoir')}>Entraînement</a>
          <a href="/examen" aria-current={courant('/examen')}>Examen blanc</a>
          <a href="/themes" aria-current={courant('/themes', '/theme', '/notion')}>Programme</a>
          <a href="/guide" aria-current={courant('/guide')}>Guide</a>
          <a href="/profil" aria-current={courant('/profil')}>Ta fiche</a>
        </nav>
        {/* Sur un téléphone, la barre s'ouvre sur l'entrée courante. */}
        <script is:inline set:html={SCRIPT_DEFILEMENT_NAVIGATION} />
      </div>
    </header>
    )}

    <Recherche />

    {!POUR_APP && miettes.length > 0 && (
      <nav class="page ariane" aria-label="Fil d’Ariane">
        <ol>
          <li><a href="/">Accueil</a></li>
          {miettes.map((m, i) => (
            <li>
              {i === miettes.length - 1 ? (
                <span aria-current="page">{m.nom}</span>
              ) : (
                <a href={m.chemin}>{m.nom}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}

    {POUR_APP ? (
      <main id="contenu" transition:animate={{ forwards: fondu, backwards: fondu }} data-retour={retour ? '' : undefined}>
        {/* Le fil d'Ariane réduit à un geste : remonter d'un échelon. */}
        {retour && (
          <div class="page retour">
            <a class="retour__lien" href={retour.chemin}>
              <span class="retour__chevron" aria-hidden="true">‹</span>
              Retour<span class="visuellement-cache"> : {retour.nom}</span>
            </a>
          </div>
        )}
        <slot />
      </main>
    ) : (
      <main id="contenu">
        <slot />
      </main>
    )}

    {!POUR_APP && (
    <footer class="pied">
      <div class="page pied__interieur">
        <p>
          Site de révision indépendant, sans lien avec l’administration. Il prépare
          <strong>au format de l’épreuve</strong>, il ne délivre aucun titre.
          Chaque question cite le texte dont elle est tirée.
        </p>
        <p class="discret">
          Banque version {version}. {
            relecture.parUnePersonne === relecture.total ? (
              <Fragment>
                Toutes les questions sont relues par <a href="/a-propos">Alexis Morain</a>, seul à ce stade.
              </Fragment>
            ) : (
              <Fragment>
                {relecture.parUnePersonne} des {relecture.total} questions sont relues par{' '}
                <a href="/a-propos">Alexis Morain</a> ; les autres ne le sont, pour l’instant, que par le
                modèle qui les a écrites à partir de l’article cité.
              </Fragment>
            )
          } Une erreur ? Le bouton de signalement est sur chaque question.
        </p>
        <nav class="pied__plan" aria-label="Plan du site">
          <a href="/cours">Le cours, leçon par leçon</a>
          <a href="/fiches-revision">Fiches de révision en PDF</a>
          <a href="/entrainement">Entraînement par thème</a>
          <a href="/examen">Examen blanc</a>
          <a href="/themes">Le programme, thème par thème</a>
          <a href="/guide">Guide du permis côtier</a>
          <a href="/profil">Ta fiche</a>
          <a href={APP_STORE.url} data-mesure="pied-app-store">L’app iPhone</a>
          <a href="/a-propos">Qui écrit ces questions</a>
          <a href="/credits">Crédits</a>
          <a href="/parametres">Réglages</a>
        </nav>
        <p class="discret">
          Code sous <a href="https://opensource.org/licenses/MIT">licence MIT</a>,
          banque de questions sous <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.fr">CC BY-SA 4.0</a>.
          Visuels repris de Wikimedia Commons : <a href="/credits">crédits et licences</a>.
          Textes réglementaires cités sous Licence Ouverte 2.0.
        </p>
        <p class="discret">
          © {annee} Alexis Morain. <a href="https://github.com/alexis-morain/permis-cotier">Code source</a>.
        </p>
      </div>
    </footer>
    )}

    <style>
      .ariane { padding-block: 0.9rem 0; font-size: 0.875rem; color: var(--texte-doux); }
      .ariane ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; }
      .ariane li + li::before { content: "›"; margin-right: 0.4rem; color: var(--filet-fort); }
      .ariane a { color: inherit; text-decoration: none; }
      @media (hover: hover) and (pointer: fine) {
        .ariane a:hover { text-decoration: underline; }
      }
      .ariane [aria-current="page"] { color: var(--texte); }

      /* Le plan du site : une liste de liens, donc en encre et sans trait. */
      .pied__plan {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        margin: 1.5rem 0;
        font-size: 0.875rem;
      }
      .pied__plan a { color: var(--texte); text-decoration: none; }
      @media (hover: hover) and (pointer: fine) {
        .pied__plan a:hover { text-decoration: underline; }
      }

      /* L'en-tête : blanc, 56 px, un filet dessous. */
      .entete {
        background: var(--fond);
        border-bottom: 1px solid var(--filet);
      }
      /* Trois pièces, deux dispositions : la marque et le champ vont ensemble,
         la navigation se met où elle tient. En grille et non en flux, parce
         qu'elles n'ont pas le même ordre sur un téléphone et sur un écran. */
      .entete__interieur {
        display: grid;
        grid-template-areas: 'marque recherche nav';
        grid-template-columns: auto auto minmax(0, 1fr);
        align-items: center;
        gap: 0.5rem 1.5rem;
        min-height: 3.5rem;
      }
      .marque { grid-area: marque; }
      .ouvrir-recherche { grid-area: recherche; }
      .entete nav { grid-area: nav; justify-self: end; }
      .marque {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 2.75rem;
        color: var(--texte);
        text-decoration: none;
      }
      .marque__glyphe { flex: none; }
      /* En sombre, le carré d'encre se perd sur le fond : un liseré à l'encre
         du jour le tient. En clair, l'encre et le carré sont le même noir. */
      .marque__fond { stroke: var(--action); stroke-opacity: 0.35; }
      .marque__nom {
        font-weight: 600;
        font-size: 0.9375rem;
        white-space: nowrap;
      }
      .entete nav {
        display: flex;
        gap: 0 0.25rem;
        margin-inline: -0.625rem;
      }
      /* Sous 48 rem, la navigation prend sa propre ligne. Six entrées, la
         marque et la loupe ne tiennent pas côte à côte : la ligne file jusqu'aux
         bords de l'écran et se fait glisser au doigt, le fondu à droite le dit.
         Les réglages sont aussi dans le plan du site, en pied de page.

         Le fondu à gauche dit l'inverse : il y a des entrées avant. Il n'a pas
         lieu d'être au début de la barre, et la barre ne commence pas toujours
         au début, puisqu'elle s'ouvre sur l'entrée courante. Sa largeur suit
         donc le défilement, de rien à 2,5 rem sur les premiers 2,5 rem. Sans
         animation pilotée par le défilement, il reste à zéro : la coupe nette
         d'avant. */
      @property --fondu-gauche {
        syntax: '<length>';
        inherits: false;
        initial-value: 0px;
      }
      @keyframes fondu-gauche {
        to { --fondu-gauche: 2.5rem; }
      }
      @media (max-width: 47.999rem) {
        .entete__interieur {
          grid-template-areas: 'marque recherche' 'nav nav';
          grid-template-columns: minmax(0, 1fr) auto;
          gap: 0;
          padding-block: 0.25rem;
        }
        .entete nav {
          justify-self: stretch;
          justify-content: flex-start;
          gap: 0 0.125rem;
          margin-inline: -1.25rem;
          padding-inline: 1rem 2.5rem;
          padding-block: 0.25rem;
          overflow-x: auto;
          scrollbar-width: none;
          -webkit-overflow-scrolling: touch;
          mask-image: linear-gradient(
            to right,
            transparent 0,
            #000 var(--fondu-gauche),
            #000 calc(100% - 2.5rem),
            transparent
          );
        }
        @supports (animation-timeline: scroll()) {
          .entete nav {
            animation: fondu-gauche linear both;
            animation-timeline: scroll(self inline);
            animation-range: 0 2.5rem;
          }
        }
        .entete nav::-webkit-scrollbar { display: none; }
        .entete nav a { padding-inline: 0.5rem; font-size: 0.875rem; white-space: nowrap; flex: 0 0 auto; }
      }
      .entete nav a {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        padding: 0.25rem 0.625rem;
        font-size: 0.875rem;
        color: var(--texte-doux);
        text-decoration: none;
        border-radius: var(--rayon-petit);
        transition: background-color var(--transition), color var(--transition);
      }
      @media (hover: hover) and (pointer: fine) {
        .entete nav a:hover { background: var(--fond-2); color: var(--texte); }
      }
      /* La page où on est : l'encre, 600, sur la teinte. Plus de trait. */
      .entete nav a[aria-current='page'] {
        background: var(--teinte);
        color: var(--texte);
        font-weight: 600;
      }
      @media (min-width: 48rem) {
        .entete nav a { min-height: 2rem; }
      }

      .pied {
        margin-top: 5rem;
        border-top: 1px solid var(--filet);
        background: var(--fond-2);
      }
      .pied__interieur { padding-block: 2.5rem 3.5rem; }
      .pied p { max-width: var(--mesure); }
    </style>
  </body>
</html>
