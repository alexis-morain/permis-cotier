---
import '../styles/global.css';
import { comptesDeRelecture, versionBanque } from '../lib/banque';
import {
  SITE,
  titrePage,
  descriptionPage,
  filAriane,
  siteWeb,
  graphe,
  type JsonLd,
  cheminServi,
  type Miette,
} from '../lib/seo';

interface Props {
  titre: string;
  description: string;
  /** Laisser à false sur les écrans de jeu, qui n'ont rien à indexer. */
  indexable?: boolean;
  canonique?: string;
  /** Fil d'Ariane, sans l'accueil : il est ajouté en tête. */
  miettes?: readonly Miette[];
  /** Nœuds JSON-LD propres à la page, ajoutés au graphe du site. */
  jsonLd?: readonly JsonLd[];
  /** Image de partage, relative à la racine. */
  image?: string;
  imageAlt?: string;
}

const {
  titre,
  description,
  indexable = true,
  canonique,
  miettes = [],
  jsonLd = [],
  image = '/partage/le-permis-cotier.png',
  imageAlt = 'Le Permis Côtier — examens blancs au format de l’épreuve',
} = Astro.props;

const base = Astro.site ?? new URL(SITE.domaine);
const url = canonique ?? new URL(cheminServi(Astro.url.pathname), base).href;
const titreComplet = titrePage(titre);
const descriptionCourte = descriptionPage(description);
const imageAbsolue = new URL(image, base).href;

// Le graphe rassemble ce qui vaut pour tout le site et ce qui vaut pour la
// page. Les écrans non indexables n'en portent pas : baliser ce qu'on demande
// aux moteurs d'ignorer ne sert personne.
const noeuds: JsonLd[] = indexable
  ? [
      siteWeb(base),
      ...(miettes.length > 0
        ? [filAriane([{ nom: 'Accueil', chemin: '/' }, ...miettes], base)]
        : []),
      ...jsonLd,
    ]
  : [];

const version = versionBanque();
const annee = new Date().getFullYear();
const relecture = await comptesDeRelecture();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={descriptionCourte} />
    <link rel="canonical" href={url} />
    {!indexable && <meta name="robots" content="noindex, follow" />}
    {indexable && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={descriptionCourte} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imageAbsolue} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titreComplet} />
    <meta name="twitter:description" content={descriptionCourte} />
    <meta name="twitter:image" content={imageAbsolue} />

    <meta name="author" content={SITE.auteur} />
    <meta name="theme-color" content="#16231f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {noeuds.length > 0 && <script type="application/ld+json" set:html={graphe(noeuds)} is:inline />}
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>

    <header class="entete">
      <div class="page entete__interieur">
        <a href="/" class="entete__marque">
          <span class="entete__nom">Le Permis Côtier</span>
          <span class="entete__sous">révision</span>
        </a>
        <nav aria-label="Navigation principale">
          <a href="/entrainement">Entraînement</a>
          <a href="/themes">Thèmes</a>
          <a href="/guide">Guide</a>
          <a href="/parametres">Réglages</a>
        </nav>
      </div>
    </header>

    {miettes.length > 0 && (
      <nav class="page ariane" aria-label="Fil d’Ariane">
        <ol>
          <li><a href="/">Accueil</a></li>
          {miettes.map((m, i) => (
            <li>
              {i === miettes.length - 1 ? (
                <span aria-current="page">{m.nom}</span>
              ) : (
                <a href={m.chemin}>{m.nom}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <main id="contenu">
      <slot />
    </main>

    <footer class="pied">
      <div class="page pied__interieur">
        <p>
          Site de révision indépendant, sans lien avec l’administration. Il prépare
          <strong>au format de l’épreuve</strong>, il ne délivre aucun titre.
          Chaque question cite le texte dont elle est tirée.
        </p>
        <p class="discret">
          Banque version {version}. {
            relecture.parUnePersonne === relecture.total
              ? 'Toutes les questions sont relues par Alexis Morain, seul à ce stade.'
              : `${relecture.parUnePersonne} des ${relecture.total} questions sont relues par Alexis Morain ; les autres ne le sont, pour l’instant, que par le modèle qui les a écrites à partir de l’article cité.`
          } Une erreur ? Le bouton de signalement est sur chaque question.
        </p>
        <nav class="pied__plan" aria-label="Plan du site">
          <a href="/examen">Examen blanc</a>
          <a href="/entrainement">Entraînement par thème</a>
          <a href="/themes">Les quatorze thèmes</a>
          <a href="/guide">Guide du permis côtier</a>
          <a href="/credits">Crédits</a>
        </nav>
        <p class="discret">
          Code sous <a href="https://opensource.org/licenses/MIT">licence MIT</a>,
          banque de questions sous <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.fr">CC BY-SA 4.0</a>.
          Visuels repris de Wikimedia Commons : <a href="/credits">crédits et licences</a>.
          Textes réglementaires cités sous Licence Ouverte 2.0.
        </p>
        <p class="discret">
          © {annee} {SITE.auteur}. <a href="https://github.com/alexis-morain/permis-cotier">Code source</a>.
        </p>
      </div>
    </footer>

    <style>
      .entete {
        border-bottom: var(--filet-epaisseur) solid var(--filet);
        background: var(--fond);
      }
      .entete__interieur {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem 1.5rem;
        padding-block: 0.85rem;
      }
      .entete__marque {
        display: flex;
        align-items: baseline;
        gap: 0.45rem;
        text-decoration: none;
      }
      .entete__nom {
        font-family: var(--serif);
        font-size: 1.15rem;
        font-weight: 600;
      }
      .entete__sous {
        color: var(--texte-doux);
        font-size: 0.8rem;
      }
      .entete nav {
        display: flex;
        gap: 1.25rem;
        font-size: 0.95rem;
      }
      .entete nav a { text-decoration: none; }
      .entete nav a:hover { text-decoration: underline; text-decoration-color: var(--accent); }

      .ariane { padding-block: 0.9rem 0; font-size: 0.85rem; color: var(--texte-doux); }
      .ariane ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; }
      .ariane li + li::before { content: "›"; margin-right: 0.4rem; color: var(--filet); }
      .ariane a { color: inherit; text-decoration: none; }
      .ariane a:hover { text-decoration: underline; text-decoration-color: var(--accent); }
      .ariane [aria-current="page"] { color: var(--encre); }

      .pied {
        margin-top: 5rem;
        border-top: var(--filet-epaisseur) solid var(--filet);
        background: color-mix(in srgb, var(--eau) 35%, var(--fond));
      }
      .pied__interieur { padding-block: 2.5rem 3.5rem; }
      .pied p { max-width: 58ch; }
      .pied p:first-child { font-size: 1rem; }
      .pied__plan {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        margin: 1.5rem 0;
        font-size: 0.9rem;
      }
    </style>
  </body>
</html>
