---
import Base from '../layouts/Base.astro';
import RecherchePanneau from '../components/RecherchePanneau.astro';
import { themesAvecComptes } from '../lib/banque';
import { GUIDE } from '../lib/guide';
import { COURS, cheminCours, leconsDuCours } from '../lib/parcours';

/**
 * La page de la recherche, et le sommaire du site.
 *
 * Elle a deux raisons d'exister. La première : la loupe de l'en-tête est un
 * lien avant d'être un bouton, et un lien doit mener quelque part, même sans
 * script. La seconde : chercher suppose de savoir quoi taper. Sous le champ,
 * tout est là, à plat — les quatorze cours, leurs cent cinq leçons, les pages
 * de thème et le guide. On y parcourt ce qu'on ne sait pas encore nommer.
 *
 * En `noindex` : la page ne dit rien que les leçons et les fiches ne disent
 * mieux, mais ses liens se suivent.
 */
const comptes = new Map((await themesAvecComptes()).map((t) => [t.code, t.publiees]));
const cours = COURS.map((c) => ({ ...c, lecons: leconsDuCours(c.code), questions: comptes.get(c.code) ?? 0 }));
---

<Base
  titre="Chercher dans le site"
  description="Trouver une notion, une leçon, un thème ou une question du permis côtier."
  indexable={false}
>
  <div class="page page--etroite" style="padding-block:2.5rem 0">
    <h1>Chercher</h1>
    <p class="chapo">
      Tape un mot du programme — <b>cardinale</b>, <b>feu vert</b>, <b>VHF</b>, <b>marée</b> — et
      tombe sur la leçon, la fiche ou la question qui en parle.
    </p>

    <RecherchePanneau mode="page" />
  </div>

  <div class="page page--etroite sommaire">
    <h2 id="cours">Les quatorze cours</h2>
    <p class="discret">
      Un cours par thème du programme, dans l’ordre où on l’apprend : d’abord ce qu’on voit sur
      l’eau, puis les règles de rencontre, puis ce qui se prépare à terre. Une leçon par notion.
    </p>
    <ol class="sommaire__cours">
      {
        cours.map((c) => (
          <li>
            <h3><a href={cheminCours(c.code)}>{c.titre}</a></h3>
            <p class="discret">{c.promesse}</p>
            <ul class="sommaire__liens">
              {c.lecons.map((l) => (
                <li><a href={l.chemin}>{l.notion.nom}</a></li>
              ))}
            </ul>
            <p class="discret sommaire__theme">
              <a href={`/theme/${c.code}`}>
                {c.questions > 0 ? `Les ${c.questions} questions du thème` : 'La page du thème'}
              </a>
            </p>
          </li>
        ))
      }
    </ol>

    <h2 id="guide">Le guide, et le reste</h2>
    <ul class="sommaire__liens sommaire__liens--large">
      {GUIDE.map((p) => <li><a href={`/guide/${p.slug}`}>{p.court}</a></li>)}
      <li><a href="/themes">Les quatorze thèmes</a></li>
      <li><a href="/examen">Examen blanc</a></li>
      <li><a href="/entrainement">Entraînement par thème</a></li>
      <li><a href="/a-propos">Qui écrit ces questions</a></li>
      <li><a href="/credits">Crédits des visuels</a></li>
      <li><a href="/parametres">Réglages</a></li>
    </ul>
  </div>
</Base>

<style>
  .sommaire { padding-block: 1rem 2rem; }
  /* Un sommaire se balaie, il ne se lit pas : la mesure de lecture n'a rien à
     y faire, elle couperait les rangées de liens au milieu. */
  .sommaire li, .sommaire__cours > li p { max-width: none; }
  .sommaire h2 {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--filet);
    font-size: 1.5rem;
  }
  .sommaire h3 { font-size: 1.05rem; margin-bottom: 0.25rem; }
  .sommaire h3 a { text-decoration: none; }
  .sommaire h3 a:hover { text-decoration: underline; text-decoration-color: var(--jaune); }

  .sommaire__cours { list-style: none; margin: 0; padding: 0; counter-reset: cours; }
  .sommaire__cours > li { margin-bottom: 1.75rem; }
  /* Le numéro remplace le sur-titre : il situe sans crier. */
  .sommaire__cours > li h3::before {
    counter-increment: cours;
    content: counter(cours) ". ";
    color: var(--texte-doux);
    font-variant-numeric: tabular-nums;
  }
  .sommaire__cours > li p { margin: 0 0 0.5rem; }

  .sommaire__theme { margin: 0.5rem 0 0; }

  .sommaire__liens {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
  }
  .sommaire__liens a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.65rem;
    border: 2px solid var(--filet);
    border-radius: var(--rayon-petit);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }
  .sommaire__liens a:hover { background: var(--fond-2); border-color: var(--filet-fort); }
  .sommaire__liens--large a { font-size: 0.9375rem; }
</style>
