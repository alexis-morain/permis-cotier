---
import Base from '../layouts/Base.astro';

// Deux chemins, dans cet ordre. Si Turnstile est configuré au build, le
// formulaire poste sur `/api/signaler` : le Worker vérifie le jeton, ouvre une
// issue publique dans le dépôt, et rien d'autre ne circule. À la moindre
// réponse hors 2xx, à la moindre panne réseau, et quand la clé publique manque,
// il retombe sur le courrier pré-rempli — le repli d'origine, qui n'a jamais
// quitté la page. La promesse du pied de page ne casse donc jamais, endpoint
// éteint compris.
const ADRESSE = 'alexis@morain.fr';

// Clé publique, visible dans le source de la page : c'est sa nature. Elle
// entre au build, jamais par un secret de Worker. Le secret qui va avec,
// `TURNSTILE_SECRET_KEY`, ne sort pas du Worker.
const CLE_TURNSTILE =
  import.meta.env.TURNSTILE_SITE_KEY ?? process.env.TURNSTILE_SITE_KEY ?? '';
const ENVOI_EN_LIGNE = CLE_TURNSTILE !== '';
---

<Base titre="Signaler une erreur" description="Signaler une question fausse ou une explication incorrecte." indexable={false}>
  <div class="page page--etroite" style="padding-block:3rem 0">
    <h1>Une question te paraît fausse ?</h1>
    <p>
      Dis-moi laquelle et pourquoi. Chaque signalement est relu contre le texte cité, et la
      question est corrigée ou retirée. La correction est publique, elle passe par le dépôt.
      Les erreurs signalées sont traitées dans la semaine.
    </p>

    <form class="signalement" id="signalement" method="post" enctype="text/plain"
      action={`mailto:${ADRESSE}`} data-adresse={ADRESSE} data-turnstile={CLE_TURNSTILE}>
      <p>
        <label for="question">Identifiant de la question</label>
        <input id="question" name="question" class="champ" required readonly />
        <span class="discret">Rempli automatiquement depuis la question d’où tu viens.</span>
      </p>
      <p>
        <label for="motif">Qu’est-ce qui ne va pas ?</label>
        <select id="motif" name="motif" class="champ" required>
          <option value="reponse">La bonne réponse indiquée est fausse</option>
          <option value="explication">L’explication est fausse ou incomplète</option>
          <option value="source">La source ne dit pas ça</option>
          <option value="visuel">Le visuel est faux ou illisible</option>
          <option value="formulation">La question est mal formulée ou ambiguë</option>
          <option value="autre">Autre</option>
        </select>
      </p>
      <p>
        <label for="details">Précise, si tu peux</label>
        <textarea id="details" name="details" class="champ" rows="5" maxlength="1200"
          placeholder="La règle 26 parle du chalutier, pas du navire à la traîne."></textarea>
      </p>
      {ENVOI_EN_LIGNE ? (
        <p class="discret">
          Le signalement part seul : ni adresse, ni adresse IP, ni cookie — rien de toi
          n’entre dans la fiche publique qu’il devient. La vérification anti-robot
          ci-dessous et la mesure d’audience voient ta connexion, comme tout site voit qui
          l’appelle ; le signalement, lui, n’en garde rien. Tu veux une réponse
          personnelle ? Écris-moi plutôt à <a href={`mailto:${ADRESSE}`}>{ADRESSE}</a> : c’est
          le seul endroit où une adresse circule, et c’est toi qui la donnes.
        </p>
      ) : (
        <p class="discret">
          Le message part de ta boîte, ton adresse m’est donc visible et ne sert qu’à te répondre.
          Rien n’est enregistré ailleurs, aucun compte, aucune adresse IP conservée.
        </p>
      )}
      {ENVOI_EN_LIGNE && (
        <div class="cf-turnstile" data-sitekey={CLE_TURNSTILE} data-language="fr"
          data-action="signalement" data-appearance="interaction-only"></div>
      )}
      <p>
        <button class="bouton bouton--principal" id="envoyer" type="submit">
          {ENVOI_EN_LIGNE ? 'Envoyer le signalement' : 'Préparer le signalement'}
        </button>
      </p>
      <noscript>
        <p class="discret">
          Sans JavaScript, écris directement à <a href={`mailto:${ADRESSE}`}>{ADRESSE}</a> en
          citant l’identifiant de la question.
        </p>
      </noscript>
    </form>

    <div class="confirmation" id="confirmation-envoi" role="status" tabindex="-1" hidden>
      <p class="confirmation__titre">C’est parti. Merci.</p>
      <p>
        Le signalement est relu contre le texte cité, et la question est corrigée ou retirée.
        Rien de personnel n’a été enregistré.
      </p>
      <p class="discret" id="lien-issue-ligne" hidden>
        La correction est publique : <a id="lien-issue" href="#" rel="noopener noreferrer"
          target="_blank">suivre le signalement dans le dépôt</a>.
      </p>
      <p>
        <a class="bouton bouton--discret" href="/entrainement">Revenir à l’entraînement</a>
      </p>
    </div>

    <div class="confirmation" id="confirmation" role="status" tabindex="-1" hidden>
      <p class="confirmation__titre">Ton logiciel de courrier s’ouvre avec le message pré-rempli.</p>
      <p>
        Il ne part pas tout seul : relis-le, puis envoie-le. Rien n’est enregistré ici.
      </p>
      <p class="discret">
        Rien ne s’est ouvert ? Écris à <a href={`mailto:${ADRESSE}`}>{ADRESSE}</a> en citant
        l’identifiant <b id="confirmation-id">de la question</b>. C’est la même chose, à la main.
      </p>
      <p>
        <a class="bouton bouton--discret" href="/entrainement">Revenir à l’entraînement</a>
      </p>
    </div>
  </div>

  {ENVOI_EN_LIGNE && (
    <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
  )}

  <script is:inline>
    const champ = document.getElementById('question');
    const id = new URLSearchParams(location.search).get('question');
    if (champ) {
      if (id) champ.value = id;
      else champ.removeAttribute('readonly');
    }

    const formulaire = document.getElementById('signalement');
    const adresse = formulaire?.dataset.adresse ?? '';
    const cleTurnstile = formulaire?.dataset.turnstile ?? '';
    const confirmation = document.getElementById('confirmation');
    const confirmationEnvoi = document.getElementById('confirmation-envoi');
    const bouton = document.getElementById('envoyer');

    const MOTIFS = {
      reponse: 'la bonne réponse indiquée est fausse',
      explication: 'l’explication est fausse ou incomplète',
      source: 'la source ne dit pas ça',
      visuel: 'le visuel est faux ou illisible',
      formulation: 'la question est mal formulée ou ambiguë',
      autre: 'autre',
    };

    /** Le repli, inchangé : un courrier pré-rempli que le visiteur relit et envoie. */
    function replierSurCourrier(question, motif, details) {
      const corps = [
        `Question : ${question}`,
        `Motif : ${MOTIFS[motif] ?? motif}`,
        '',
        details || '(rien de plus)',
        '',
        // Le domaine du site, jamais `location.origin` : dans la coquille il
        // vaut « capacitor://localhost », et le lien serait inouvrable pour qui
        // reçoit le signalement.
        `Page : https://lepermiscotier.fr/question/${question}`,
      ].join('\n');

      const lien =
        `mailto:${adresse}` +
        `?subject=${encodeURIComponent(`Signalement ${question}`)}` +
        `&body=${encodeURIComponent(corps)}`;

      const marque = document.getElementById('confirmation-id');
      if (marque && question) marque.textContent = question;
      if (formulaire) formulaire.hidden = true;
      if (confirmation) {
        confirmation.hidden = false;
        confirmation.focus();
      }
      window.umami?.track('signalement-prepare', { motif });
      location.href = lien;
    }

    function annoncerEnvoi(url) {
      if (formulaire) formulaire.hidden = true;
      const ligne = document.getElementById('lien-issue-ligne');
      const lien = document.getElementById('lien-issue');
      if (url && ligne && lien) {
        lien.href = url;
        ligne.hidden = false;
      }
      if (confirmationEnvoi) {
        confirmationEnvoi.hidden = false;
        confirmationEnvoi.focus();
      }
    }

    formulaire?.addEventListener('submit', async (evenement) => {
      evenement.preventDefault();
      const question = (document.getElementById('question')?.value ?? '').trim();
      const motif = document.getElementById('motif')?.value ?? 'autre';
      const details = (document.getElementById('details')?.value ?? '').trim();

      // Pas de clé publique au build, pas de widget chargé, pas de jeton :
      // l'endpoint refuserait de toute façon. Droit au courrier.
      const jeton = cleTurnstile ? (window.turnstile?.getResponse() ?? '') : '';
      if (!cleTurnstile || !jeton) {
        replierSurCourrier(question, motif, details);
        return;
      }

      if (bouton) {
        bouton.disabled = true;
        bouton.textContent = 'Envoi…';
      }

      try {
        const reponse = await fetch('/api/signaler', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ question, motif, details, turnstile: jeton }),
        });
        if (!reponse.ok) throw new Error(`HTTP ${reponse.status}`);
        const rendu = await reponse.json().catch(() => ({}));
        // Le motif seul part à la mesure : jamais le texte du signalement.
        window.umami?.track('signalement-envoye', { motif });
        annoncerEnvoi(typeof rendu.url === 'string' ? rendu.url : '');
      } catch {
        window.turnstile?.reset();
        if (bouton) {
          bouton.disabled = false;
          bouton.textContent = 'Envoyer le signalement';
        }
        replierSurCourrier(question, motif, details);
      }
    });
  </script>
</Base>

<style>
  .signalement { margin-top: 2rem; max-width: 34rem; }
  .signalement label { display: block; font-weight: 700; margin-bottom: 0.35rem; }
  .signalement textarea { min-height: 7rem; resize: vertical; }
  .signalement .discret { display: block; margin-top: 0.3rem; }
  .signalement :global(.cf-turnstile) { margin: 1rem 0; }

  .confirmation {
    margin-top: 2rem;
    max-width: 34rem;
    border-radius: var(--rayon);
    padding: 1.25rem;
    background: var(--vert-pale);
  }
  .confirmation__titre { font-weight: 800; font-stretch: var(--large); color: var(--vert-texte); margin-top: 0; }
  .confirmation p:last-child { margin-bottom: 0; }
</style>
