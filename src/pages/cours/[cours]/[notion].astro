---
import Base from '../../../layouts/Base.astro';
import Lecon, { type Suite } from '../../../components/Lecon.tsx';
import {
  leconsDuParcours,
  leconsDuCours,
  coursSuivant,
  cheminCours,
  type Lecon as LeconDuParcours,
} from '../../../lib/parcours';
import { leconDeLaNotion } from '../../../lib/lecons';
import { themeParCode } from '../../../lib/themes';
import { SITE, ressource } from '../../../lib/seo';

export async function getStaticPaths() {
  return leconsDuParcours().map((lecon) => ({
    params: { cours: lecon.cours.code, notion: lecon.notion.code },
    props: { lecon },
  }));
}

const { lecon } = Astro.props as { lecon: LeconDuParcours };
const { notion, cours } = lecon;
const affichable = await leconDeLaNotion(notion);
const theme = themeParCode(notion.theme);
const nomTheme = theme?.nom ?? notion.theme;
const chemin = lecon.chemin;
const base = Astro.site ?? SITE.domaine;

const duCours = leconsDuCours(cours.code);
const apres = leconsDuParcours()[lecon.rang];

// Ce qui vient après : la leçon suivante tant qu'on est dans le cours, puis
// le cours d'après. La dernière leçon du parcours ne mène nulle part.
let suite: Suite | undefined;
if (apres && apres.cours.code === cours.code) {
  suite = { type: 'lecon', chemin: apres.chemin, nom: apres.notion.nom };
} else {
  const suivant = coursSuivant(cours.code);
  if (suivant) suite = { type: 'cours', chemin: cheminCours(suivant.code), titre: suivant.titre };
}

// Une leçon courte n'est que le résumé de sa fiche : elle se joue, elle ne
// s'indexe pas, la fiche de notion est déjà là pour ça.
const indexable = !affichable.courte;
const description = affichable.accroche ?? notion.resume;
---

<Base
  titre={`${notion.nom} : la leçon`}
  description={description}
  indexable={indexable}
  miettes={[
    { nom: 'Cours', chemin: '/cours' },
    { nom: cours.titre, chemin: cheminCours(cours.code) },
    { nom: notion.nom, chemin },
  ]}
  jsonLd={
    indexable
      ? [
          ressource(
            {
              nom: `${notion.nom} : la leçon`,
              resume: description,
              chemin,
              theme: nomTheme,
              nombreQuestions: affichable.questions.length,
              type: affichable.questions.length > 0 ? ['Leçon', 'Questions d’entraînement'] : 'Leçon',
            },
            base,
          ),
        ]
      : []
  }
>
  {/* Avant l'îlot : la classe qui autorise le pas à pas. Posée ici et non
      dans le layout, elle ne dit rien aux autres pages. */}
  <script is:inline>document.documentElement.classList.add('js');</script>

  <article class="page page--etroite" style="padding-block:2.5rem 0">
    <p class="chapitre"><a href={cheminCours(cours.code)}>{cours.titre}</a></p>
    <h1>{notion.nom}</h1>

    <Lecon
      client:load
      lecon={affichable}
      cours={{ code: cours.code, titre: cours.titre, chemin: cheminCours(cours.code) }}
      rang={lecon.rangDansCours}
      total={duCours.length}
      suite={suite}
      theme={{ code: notion.theme, nom: nomTheme }}
    />
  </article>

  <aside class="page page--etroite origine">
    {affichable.courte ? (
      <Fragment>
        <h2>Cette leçon n’est pas encore rédigée</h2>
        <p>
          Elle reprend le résumé de la notion, celui de sa <a href={`/notion/${notion.code}`}>fiche</a>,
          et ses questions. La leçon détaillée viendra quand le texte qui la fonde aura été
          dépouillé.
        </p>
      </Fragment>
    ) : (
      <Fragment>
        <h2>D’où vient cette leçon</h2>
        <ul>
          {affichable.sources.map((s) => (
            <li>{s.url ? <a href={s.url} rel="noreferrer noopener" data-mesure="source-ouverte">{s.texte}</a> : s.texte}</li>
          ))}
        </ul>
        <p class="discret">
          {affichable.reluPar ? (
            <Fragment>Leçon écrite depuis les textes cités et relue par {affichable.reluPar}.</Fragment>
          ) : (
            <Fragment>
              Leçon écrite depuis les textes cités, pas encore relue par une personne : une erreur
              est possible. <a href="/signaler">Signale-la</a>, la correction arrive dans la semaine.
            </Fragment>
          )}
        </p>
      </Fragment>
    )}
    <p class="discret origine__liens">
      Programme de l’épreuve, arrêté du 28 septembre 2007, art. 1er § 1.2 : « {notion.ancrage} ».
      Leçon {lecon.rangDansCours} sur {duCours.length} du cours
      « <a href={cheminCours(cours.code)}>{cours.titre}</a> ».
      Thème <a href={`/theme/${notion.theme}`}>{nomTheme.toLowerCase()}</a>,
      fiche <a href={`/notion/${notion.code}`}>{notion.nom.toLowerCase()}</a>.
    </p>
  </aside>
</Base>

<style>
  h1 { margin-bottom: 1.25rem; }

  .origine {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--filet);
  }
  .origine h2 { font-size: 1.05rem; }
  .origine ul { padding-left: 1.1rem; margin: 0 0 0.8rem; }
  .origine li { margin-bottom: 0.3rem; }
  .origine__liens { margin-top: 1rem; }
</style>
