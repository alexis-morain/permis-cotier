---
import Base from '../layouts/Base.astro';
import SansScript from '../components/SansScript.astro';
import Quiz from '../components/Quiz.tsx';
import { cheminBanque } from '../lib/banque';

// La banque n'est plus sérialisée dans la page : elle arrive par un JSON dont
// le nom porte la version, commun aux seize écrans de jeu et gardé en cache
// immuable. La page tombe de sept cents kilo-octets à quelques-uns.
const banque = cheminBanque();
---

<Base
  titre="Examen blanc, permis côtier"
  description="Quarante questions tirées au sort, vingt secondes chacune, cinq erreurs admises."
  indexable={false}
  prechargeBanque
>
  <div class="page page--etroite">
    <SansScript ecran="L’examen blanc" />
    <Quiz client:only="react" mode="examen" source={banque} />
  </div>
</Base>
