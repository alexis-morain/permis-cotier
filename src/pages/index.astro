---
import Base from '../layouts/Base.astro';
import EssaiQuestion from '../components/EssaiQuestion.astro';
import { themesAvecComptes, questionsPubliees } from '../lib/banque';
import { GUIDE } from '../lib/guide';
import { POUR_APP } from '../lib/cible';
import { COURS, cheminCours, leconsDuCours, leconsDuParcours } from '../lib/parcours';
import { codesLeconsEcrites, compteLeconsEcrites } from '../lib/lecons';
import { groupeDuTheme } from '../lib/groupes';
import { SITE, APP_STORE, absolue } from '../lib/seo';
import SCRIPT_BANDE from 'virtual:bande-avant-rendu';

const themes = await themesAvecComptes();
const questions = await questionsPubliees();
const total = questions.length;
const lecons = leconsDuParcours().map((l) => ({ code: l.notion.code, nom: l.notion.nom, chemin: l.chemin }));
const premiere = lecons[0];
const cours = await compteLeconsEcrites();
const ecrites = await codesLeconsEcrites();
const base = Astro.site ?? new URL(SITE.domaine);

// Le parcours : un cours par thème, avec ce que chacun tient aujourd'hui. Les
// comptes sont lus, jamais écrits à la main : un thème qui se remplit se voit
// ici sans qu'on y touche.
const parcours = COURS.map((c) => ({
  code: c.code,
  titre: c.titre,
  promesse: c.promesse,
  chemin: cheminCours(c.code),
  lecons: leconsDuCours(c.code).filter((l) => ecrites.has(l.notion.code)).length,
  questions: themes.find((t) => t.code === c.code)?.publiees ?? 0,
  groupe: groupeDuTheme(c.code),
}));

/**
 * La question qu'on essaie dans l'ouverture. Depuis que la page ne
 * signe plus d'un nom, la preuve doit venir du produit : une vraie question,
 * qu'on coche et qu'on valide comme à l'épreuve. Celle-ci est choisie pour
 * son visuel, qui dit la situation sans un mot, et pour ses deux bonnes
 * réponses, qui apprennent la règle du format avant le premier examen. Si
 * elle sortait de la banque, on retombe sur la première question illustrée
 * plutôt que de casser le build.
 */
const MONTREE = 'barre-route-0029';
const demo = questions.find((q) => q.id === MONTREE) ?? questions.find((q) => q.visuel);

/**
 * Ce que lisent l'ouverture de qui revient (`bande-rendu.ts`) et les blocs qui
 * suivent la progression (`accueil-site.ts`) : les leçons dans l'ordre du
 * parcours, et la banque publiée réduite à l'identifiant et au thème. En JSON
 * dans un bloc inerte, et non en props d'îlot : sérialisées dans un attribut,
 * les 570 questions faisaient 85 Ko de HTML. Le `<` est échappé pour qu'aucun
 * texte ne puisse fermer le bloc. Le bloc ouvre la bande : le script en ligne
 * qui la choisit le lit avant que le reste de la page existe.
 */
const donneesAccueil = JSON.stringify({
  lecons,
  banque: questions.map((q) => ({ id: q.id, theme: q.theme })),
}).replaceAll('<', '\\u003c');

// Les quatorze cours en `ItemList`. Pas de `FAQPage` ici : chaque page de
// guide porte déjà le sien, et l'accueil se mettrait en concurrence avec ses
// propres pages sur le même résultat enrichi.
const liste = {
  '@type': 'ItemList',
  name: 'Le cours du permis côtier, un par thème du programme',
  numberOfItems: parcours.length,
  itemListElement: parcours.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.titre,
    url: absolue(c.chemin, base),
  })),
};

// Les captures de l'app, 640 px de large, servies hors précache
// (`hors-ligne.ts`). Leur texte alternatif dit ce que l'écran montre.
const CAPTURE = { width: 640, height: 1391 };
---

<Base
  titre="Permis côtier : cours, code, QCM et test gratuit"
  description={`Le cours en ${cours.ecrites} leçons, l’entraînement par thème et l’examen blanc au format de l’épreuve. Gratuit, sans inscription, chaque réponse cite son article.`}
  jsonLd={[liste]}
>
  <section class="ouverture">
    <script type="application/json" id="accueil-donnees" is:inline set:html={donneesAccueil} />
    <div class="page ouverture__grille" data-bande-grille>
      {/* Avant la colonne du nouveau venu, pour tourner avant la première
          peinture : chez qui a déjà une trace, il pose devant la colonne de
          la suite logique, et `data-bande` sur la section cache celle-ci ;
          chez qui a un examen terminé, ses derniers examens remplacent la
          question à essayer (`data-panneau`). Sans JavaScript, rien ne
          change. Voir `bande-rendu.ts`. */}
      <script is:inline set:html={SCRIPT_BANDE} />
      <div class="ouverture__texte ouverture__texte--nouveau">
        <h1>Le permis côtier, trois minutes à la fois.</h1>
        <p class="ouverture__promesse">
          Des leçons courtes écrites depuis les textes, {total} questions qui citent leur
          article, et l’examen blanc au format du jour J. Gratuit, sans compte, sans publicité.
        </p>

        <div class="ouverture__actions">
          {premiere && (
            <a class="bouton bouton--principal" href={premiere.chemin} data-mesure="accueil-cours" data-mesure-notion={premiere.code}>Commencer le cours</a>
          )}
          <a class="bouton" href="/examen" data-mesure="accueil-examen">Passer un examen blanc</a>
        </div>

        <p class="ouverture__deja">
          Tu veux juste te situer ? L’examen blanc est aussi
          <a href="/test-permis-cotier" data-mesure="accueil-test">le test gratuit du permis côtier</a>,
          en dix minutes. Déjà en bateau-école ?
          <a href="/entrainement" data-mesure="accueil-entrainement">Entraîne-toi thème par thème</a>,
          sans chrono.
        </p>
      </div>

      {demo && (
        <div class="ouverture__cote">
          <EssaiQuestion question={demo} />
          <p class="ouverture__legende">
            Une question de la banque, telle quelle. Il y en a {total - 1} autres,
            <a href="/themes" data-mesure="accueil-themes">rangées par thème</a>.
          </p>
        </div>
      )}
    </div>
  </section>

  <section class="rang page" aria-labelledby="rang-cours">
    <div class="rang__texte">
      <h2 id="rang-cours">Une leçon, une idée, trois minutes</h2>
      <p class="chiffre">
        <b class="display">{cours.ecrites}</b>
        <span>leçons en quatorze cours, écrites depuis les textes et non depuis un manuel</span>
      </p>
      <p>
        Le cours suit l’ordre où on apprend, pas celui de l’arrêté : le balisage d’abord,
        parce qu’il se voit, puis se croiser sans se toucher, puis les feux. Chaque leçon
        tient sur un écran de téléphone, cite sa source sous chaque affirmation, et se termine
        sur les questions de la banque quand le thème en a.
      </p>
      <p class="rang__liens">
        {premiere && (
          <a href={premiere.chemin} data-mesure="accueil-rang-cours" data-mesure-notion={premiere.code}>Commencer par «&nbsp;{premiere.nom}&nbsp;»</a>
        )}
        <a href="#cours" data-mesure="accueil-rang-plan">Voir les quatorze cours</a>
      </p>
    </div>
    {/* Les captures restent hors du bundle de l'app (`elaguer-app.mjs`). */}
    {!POUR_APP && (
      <figure class="telephone rang__image">
        <img
          src="/vitrine/cours.webp"
          alt="L’écran du cours dans l’app : la leçon à reprendre, puis les chapitres du parcours avec leur avancement."
          {...CAPTURE}
          loading="lazy"
          decoding="async"
        />
      </figure>
    )}
  </section>

  <section aria-labelledby="rang-examen">
    <div class="rang rang--inverse page">
      <div class="rang__texte">
        <h2 id="rang-examen">L’examen blanc tourne comme le vrai</h2>
        <p>
          Quarante questions tirées dans les quatorze thèmes, une ou deux bonnes réponses
          chacune, vingt secondes pour répondre, cinq erreurs admises. À la fin, tu vois où
          partent tes points, thème par thème, et ce que tu rates revient en premier la fois
          suivante.
        </p>
        <p class="discret">
          Les vingt secondes ne sont pas dans l’arrêté : elles viennent des opérateurs agréés,
          et on les reprend pour que le rythme ne te surprenne pas le jour J.
        </p>
        <p class="rang__liens">
          <a class="bouton" href="/examen" data-mesure="accueil-rang-examen">Passer un examen blanc</a>
        </p>
      </div>
      {!POUR_APP && (
      <div class="duo rang__image">
        <figure class="telephone duo__avant">
          <img
            src="/vitrine/examen.webp"
            alt="Une question d’examen blanc : le chrono à vingt secondes, la troisième question sur quarante, trois propositions et le bouton « Valider et passer »."
            {...CAPTURE}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="telephone duo__arriere">
          <img
            src="/vitrine/resultat.webp"
            alt="Le résultat d’un examen blanc : 36 sur 40, reçu avec quatre erreurs sur les cinq admises, puis le score de chaque thème."
            {...CAPTURE}
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
      )}
    </div>
  </section>

  <section class="rang page" aria-labelledby="rang-source">
    <div class="rang__texte">
      <h2 id="rang-source">Chaque réponse dit d’où elle vient</h2>
      <p class="chiffre">
        <b class="display">{total}</b>
        <span>questions, écrites article par article, jamais recopiées d’un éditeur</span>
      </p>
      <p>
        On lit le texte, on écrit la question, on relit : le RIPAM pour les feux, les marques
        et les règles de barre, l’arrêté du 28 septembre 2007 pour le programme, la division
        240 pour l’armement. Sous chaque correction, l’article et son numéro.
      </p>
      <p>
        Une question te paraît fausse ? Le bouton de signalement est dessous, et la
        correction arrive dans la semaine.
      </p>
      <p class="rang__liens">
        <a href="/a-propos" data-mesure="accueil-a-propos">Comment ces questions sont écrites</a>
      </p>
    </div>
    {/* Les captures restent hors du bundle de l'app (`elaguer-app.mjs`). */}
    {!POUR_APP && (
      <figure class="telephone rang__image">
        <img
          src="/vitrine/correction.webp"
          alt="Une correction dans l’app : « Juste », l’explication de la bouée d’épave, puis les trois articles de l’arrêté du 30 novembre 2017 qui la fondent."
          {...CAPTURE}
          loading="lazy"
          decoding="async"
        />
      </figure>
    )}
  </section>

  <section class="page reprendre" aria-labelledby="reprendre">
    <h2 id="reprendre">Tes erreurs reviennent jusqu’à ce que tu les tiennes</h2>
    <p class="reprendre__chapo">
      Ce que tu rates revient dans ta série du jour, les plus anciennes d’abord. Pose la
      date de ton examen, le site compte les jours. Pas de compte, pas de mot de passe : ce
      que tu fais reste dans ton navigateur, le site marche hors ligne une fois visité, et
      tout se relit ou s’efface depuis <a href="/profil">ta fiche</a>.
    </p>
    <div class="reprendre__grille">
      {/* Vides jusqu'au script, comme les îlots `client:only` qu'ils remplacent. */}
      <div class="reprendre__etat" data-reprise></div>
      <div class="reprendre__date encadre" data-date-examen></div>
    </div>
  </section>

  {/* L'app n'a pas à se vendre à elle-même : rien de ceci dans la coquille. */}
  {!POUR_APP && (
    <section class="app" aria-labelledby="app">
      <div class="page app__grille">
        <div class="app__texte">
          <h2 id="app">Aussi sur iPhone</h2>
          <p class="app__chapo">
            Le même cours et la même banque, dans une app gratuite qui marche hors ligne, en
            mer comme dans le métro.
          </p>
          <ul class="app__plus">
            <li>Un rappel avant la date de ton examen.</li>
            <li>Les signaux sonores s’entendent, et la correction se sent sous le doigt.</li>
            <li>Ta progression reste sur ton téléphone : ni compte, ni traceur.</li>
          </ul>
          <div class="app__liens">
            <a class="app__badge" href={APP_STORE.url} data-mesure="accueil-app-store">
              <img src="/vitrine/app-store.svg" alt="Télécharger dans l’App Store" width="190" height="60" loading="lazy" />
            </a>
            <figure class="app__qr">
              <img src="/vitrine/qr-app-store.svg" alt="" width="88" height="88" loading="lazy" />
              <figcaption>Sur ordinateur, vise ce code avec l’appareil photo de ton iPhone.</figcaption>
            </figure>
          </div>
          <p class="app__android">
            Pas d’app Android pour l’instant : le site fait tout ce que fait l’app, et
            s’installe sur l’écran d’accueil depuis le menu du navigateur.
          </p>
        </div>
        <figure class="telephone app__telephone">
          <img
            src="/vitrine/accueil.webp"
            alt="L’accueil de l’app : la leçon à continuer, quatorze questions à revoir aujourd’hui, le dernier examen blanc et les jours qui restent avant l’examen."
            {...CAPTURE}
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>
  )}

  <section class="page cours" id="cours" aria-labelledby="cours-titre">
    <h2 id="cours-titre">Les quatorze cours</h2>
    <p class="discret cours__note">
      Un cours par thème du programme, dans l’ordre de l’apprentissage. Pour l’ordre de
      l’arrêté, thème par thème, va au <a href="/themes">programme</a>.
    </p>
    {/* Une vue de base : une rangée par cours. Sous 40 rem, les rangées se
        replient en liste (voir la feuille), sans défilement latéral. */}
    <table class="programme">
      <caption class="visuellement-cache">Les quatorze cours, leur groupe, leurs leçons et leurs questions</caption>
      <thead>
        <tr>
          <th scope="col">Cours</th>
          <th scope="col">Groupe</th>
          <th scope="col">Leçons</th>
          <th scope="col" class="programme__nombre">Questions</th>
        </tr>
      </thead>
      <tbody>
        {parcours.map((c) => (
          <tr>
            <th scope="row" class="programme__nom">
              <a href={c.chemin} data-mesure="accueil-cours-theme" data-mesure-theme={c.code}>{c.titre}</a>
              <span class="programme__promesse">{c.promesse}</span>
            </th>
            <td class="programme__groupe">
              {c.groupe && <span class={`etiquette etiquette--${c.groupe.couleur}`}>{c.groupe.nom}</span>}
            </td>
            <td class="programme__lecons">
              {c.lecons > 0 ? `${c.lecons} leçon${c.lecons > 1 ? 's' : ''}` : 'en résumé'}
            </td>
            <td class="programme__nombre">
              {c.questions}<span class="programme__unite"> question{c.questions > 1 ? 's' : ''}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="page guide">
    <h2>Ce qu’on se demande avant de s’inscrire</h2>
    <p>
      Jusqu’où le titre autorise à aller, ce qu’il coûte, ce que l’épreuve demande. Ces
      réponses sont dans le décret du 2 août 2007, dans l’arrêté du 28 septembre 2007 et, pour
      le CPF, dans le code du travail. Le guide cite l’article à chaque fois.
    </p>
    <ul class="guide__liens">
      {GUIDE.map((p) => (
        <li>
          <a href={`/guide/${p.slug}`} data-mesure="accueil-guide" data-mesure-page={p.slug}>{p.question}</a>
          <p class="discret">{p.reponse}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="page quoi">
    <h2>Ce que ce site est, et ce qu’il n’est pas</h2>
    <p>
      C’est un site de révision indépendant, écrit et tenu par une personne. Il prépare
      <strong>au format de l’épreuve</strong>. Il n’est ni officiel, ni agréé, il ne délivre
      aucun titre, et il ne reproduit la banque de personne : l’administration n’en publie
      aucune.
    </p>
    <p>
      Le code et la banque sont publics, sous licence libre. Le détail de la fabrication est
      sur la page <a href="/a-propos">qui écrit ces questions</a>.
    </p>
  </section>

  <script>
    import { monterAccueil } from '../components/accueil-site';
    import { quandLaPageEstPrete } from '../lib/page';

    quandLaPageEstPrete(() => monterAccueil());
  </script>
</Base>

<style is:global>
  /* Les blocs que le script rend : hors de la portée du style de page,
     puisque leurs éléments n'ont pas l'attribut de portée d'Astro. */
  .reprise { border-top: 1px solid var(--filet); padding-top: 0.9rem; margin-top: 1.25rem; font-size: 0.95rem; }
  .reprise p { margin: 0; }
  .reprise__raison { margin-top: 0.4rem; font-weight: 600; }
  .reprise q { quotes: '« ' ' »'; }

  .dateExamen label { display: block; font-weight: 600; margin-bottom: 0.4rem; }
  .dateExamen__compte { margin: 0.5rem 0 0; }
  .dateExamen__note { margin: 0.4rem 0 0; }

  /* Les derniers examens blancs de qui revient, posés par le script de
     l'ouverture à la place de la question à essayer : un `.encadre`. Une
     rangée par examen : la date en encre douce, le rail du score avec le trait
     vert de la barre d'admission à 35 sur 40, le score en étiquette de
     verdict. Le rail est sur le lavis, filet autour : en sombre, le lavis se
     détache du fond. */
  .ouverture__examens { align-self: start; }
  .ouverture__examens h2 { font-size: 1rem; font-weight: 600; margin: 0 0 0.75rem; }
  .ouverture__examens ol { list-style: none; margin: 0; padding: 0; }
  .ouverture__examens li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0;
    border-top: 1px solid var(--filet);
    max-width: none;
    font-size: 0.875rem;
  }
  .ouverture__date { color: var(--texte-doux); }
  .ouverture__examens .rail {
    position: relative;
    height: 6px;
    border-radius: 3px;
    background: var(--fond-2);
    border: 1px solid var(--filet);
  }
  .ouverture__examens .rail i {
    position: absolute;
    inset: -1px auto -1px -1px;
    width: calc(var(--part, 0) * 100% + 1px);
    min-width: 6px;
    border-radius: 3px;
    background: var(--texte);
  }
  /* Le trait de la barre d'admission : 35 sur 40, pris sur la largeur
     intérieure du rail. */
  .ouverture__examens .rail b {
    position: absolute;
    top: -4px;
    bottom: -4px;
    left: calc(35 / 40 * 100%);
    width: 2px;
    margin-left: -1px;
    background: var(--vert);
  }
  .ouverture__examens .etiquette { font-variant-numeric: tabular-nums; }
  .ouverture__examens .discret {
    margin: 0.25rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--filet);
    font-size: 0.8125rem;
  }
  /* Sur téléphone, rien sous la suite logique, comme le panneau des comptes. */
  @media (max-width: 51.99rem) {
    .ouverture__examens { display: none; }
  }
</style>

<style>
  /* L'ouverture : la page blanche. Le texte à gauche, un panneau à droite à
     partir de 52 rem. Plus de bande, plus de ligne de flottaison. */
  .ouverture__grille {
    display: grid;
    gap: 2.5rem;
    padding-block: 2.75rem 3rem;
  }
  /* La colonne de qui revient est rendue par le script en ligne, sans
     l'attribut de portée : ses classes se visent en `:global`, sous la
     section qui, elle, le porte. Posée, elle cache celle du nouveau venu. */
  .ouverture[data-bande] .ouverture__texte--nouveau { display: none; }
  /* Sur téléphone, qui revient a sa suite logique en entier sous les yeux ;
     la question à essayer est pour le nouveau venu. Sur grand écran, elle
     tient la seconde colonne. */
  @media (max-width: 51.99rem) {
    .ouverture[data-bande] .ouverture__cote { display: none; }
  }
  /* Qui a terminé un examen blanc voit ses derniers à la place de la question. */
  .ouverture[data-panneau] .ouverture__cote { display: none; }
  .ouverture :global(h1) { max-width: 20ch; margin-bottom: 0; }
  .ouverture :global(.ouverture__promesse) {
    font-size: 1.25rem;
    line-height: 1.45;
    max-width: 34rem;
    color: var(--texte-doux);
    margin-top: 1.25rem;
  }
  .ouverture :global(.ouverture__actions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .ouverture :global(.ouverture__deja) { margin: 1.5rem 0 0; font-size: 1rem; max-width: 40rem; }

  .ouverture__cote { align-self: start; min-width: 0; }
  .ouverture__legende { margin: 0.9rem 0 0; color: var(--texte-doux); font-size: 0.875rem; }

  /* Les rangs : un écran de l'app à côté de ce qu'il fait. Le texte et
     l'image alternent de côté ; la page reste blanche d'un rang à l'autre. */
  .rang {
    display: grid;
    gap: 2.25rem;
    align-items: center;
    padding-block: 3rem;
  }
  .rang__texte { min-width: 0; }
  .rang__texte h2 { max-width: 24ch; text-wrap: balance; margin-bottom: 1rem; }
  .rang__texte p { max-width: 50ch; }
  .rang__liens {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin: 1.5rem 0 0;
    font-weight: 600;
  }
  .rang__image { justify-self: center; }

  /* Un chiffre qui compte, pris dans le récit du rang, et non une rangée de stats. */
  .chiffre {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.85rem;
    margin: 0 0 1.25rem;
  }
  .chiffre .display {
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .chiffre span { font-weight: 600; max-width: 24ch; line-height: 1.3; }

  /* Le téléphone : l'écran de l'app dans un cadre noir, le seul objet de la
     page dont le coin dépasse dix pixels, parce qu'il dessine un boîtier. La
     capture porte déjà la barre d'état et l'île ; le cadre ne dessine que le
     bord, d'un filet clair autour pour qu'il se détache en sombre aussi. */
  .telephone {
    margin: 0;
    width: min(100%, 15rem);
    border: 0.4rem solid #191918;
    border-radius: 2.6rem;
    overflow: hidden;
