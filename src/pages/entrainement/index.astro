---
import Base from '../../layouts/Base.astro';
import EntrainementApp from '../../components/EntrainementApp.astro';
import { themesAvecComptes } from '../../lib/banque';
import { POUR_APP } from '../../lib/cible';
import OuvrirRecherche from '../../components/OuvrirRecherche.astro';
import { groupeDuTheme } from '../../lib/groupes';

const themes = await themesAvecComptes();
const disponibles = themes.filter((t) => t.publiees > 0);
const aVenir = themes.filter((t) => t.publiees === 0);
---

<Base
  titre="Entraînement par thème, permis côtier"
  description="Révise un thème à la fois, sans chrono, avec la correction et la source après chaque réponse."
>
  <div class="page page--etroite" style={POUR_APP ? undefined : 'padding-block:3rem 0'}>
    <h1>{POUR_APP ? 'Entraînement' : 'Un thème à la fois, sans chrono'}</h1>
    {POUR_APP && <OuvrirRecherche />}
    <p class="web-seulement">
      La correction tombe après chaque réponse, avec l’explication et le texte dont elle vient.
      Les questions ratées repassent en premier la fois suivante, et ta
      <a href="/revoir">série du jour</a> pose ce qui est dû aujourd’hui, tous thèmes mêlés.
    </p>

    {disponibles.length === 0 ? (
      <div class="encadre" style="margin-top:2rem">
        <p style="margin:0"><strong>La banque est encore vide.</strong></p>
        <p class="discret" style="margin:0.4rem 0 0">Les premiers thèmes arrivent : feux et marques, puis balisage.</p>
      </div>
    ) : (
      POUR_APP ? (
        <EntrainementApp themes={disponibles} />
      ) : (
      <ul class="choix">
        {disponibles.map((t) => (
          <li>
            <a href={`/entrainement/${t.code}`}>
              <span class="choix__nom">{t.nom}</span>
              <span class="choix__infos">
                {groupeDuTheme(t.code) && (
                  <span class={`etiquette etiquette--${groupeDuTheme(t.code)!.couleur}`}>{groupeDuTheme(t.code)!.nom}</span>
                )}
                <span class="pastille">{t.publiees} question{t.publiees > 1 ? 's' : ''}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      )
    )}

    {aVenir.length > 0 && (
      <p class="discret" style="margin-top:2rem">
        Pas encore écrits : {aVenir.map((t) => t.nom).join(', ')}.
      </p>
    )}
  </div>
</Base>

<style>
  /* Des rangées à filet, comme le programme : le thème à gauche, son groupe
     et ses questions à droite, qui passent dessous sur un téléphone. */
  .choix { list-style: none; margin: 2rem 0 0; padding: 0; }
  .choix li { border-top: 1px solid var(--filet); max-width: none; }
  .choix li:last-child { border-bottom: 1px solid var(--filet); }
  .choix a {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 0.5rem 1rem; padding: 0.75rem 0; min-height: 3.25rem;
    color: inherit; text-decoration: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .choix a:hover .choix__nom { text-decoration: underline; }
  }
  .choix__nom { font-size: 1rem; font-weight: 600; }
  .choix__infos { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  @media (max-width: 39.99rem) {
    .choix__nom { flex: 1 1 100%; }
  }
</style>
