---
import Base from '../../layouts/Base.astro';
import SansScript from '../../components/SansScript.astro';
import Quiz from '../../components/Quiz.tsx';
import { POUR_APP } from '../../lib/cible';
import { silhouetteHtml } from '../../components/quiz/silhouette-statique';
import { cheminBanque, cheminBanqueTheme, cheminIndexBanque } from '../../lib/banque';
import { THEMES } from '../../lib/themes';

export async function getStaticPaths() {
  return THEMES.map((theme) => ({ params: { theme: theme.code }, props: { theme } }));
}

const { theme } = Astro.props;
// Sur le site, la page ne charge que le fichier de son thème, plus la liste
// légère de la banque (les badges et l'indice la comptent entière). Le fichier
// complet reste le repli hors ligne, seul au précache. Dans l'app, la banque
// est dans le bundle : le fichier complet, comme avant.
const pleine = cheminBanque();
const banque = POUR_APP ? pleine : cheminBanqueTheme(theme.code);
const index = POUR_APP ? undefined : cheminIndexBanque();
const repli = POUR_APP ? undefined : pleine;
const precharge = POUR_APP ? true : [banque, index!];
---

<Base
  titre={`Entraînement : ${theme.nom}`}
  description={`Questions du thème ${theme.nom}, avec correction immédiate et source.`}
  indexable={false}
  prechargeBanque={precharge}
>
  <div class="page page--etroite">
    <p class="chapitre web-seulement" style="padding-top:1.5rem"><a href="/entrainement">Entraînement</a> · {theme.nom}</p>
    <SansScript ecran="L’entraînement" />
    <Quiz client:only="react" mode="entrainement" source={banque} sourceIndex={index} sourceRepli={repli} theme={theme.code}>
      <Fragment slot="fallback" set:html={silhouetteHtml({ examen: false })} />
    </Quiz>
  </div>
</Base>
