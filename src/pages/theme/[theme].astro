---
import Base from '../../layouts/Base.astro';
import { POUR_APP } from '../../lib/cible';
import LienQuestion from '../../components/LienQuestion.astro';
import { questionsDuTheme } from '../../lib/banque';
import { THEMES } from '../../lib/themes';
import { notionsDuTheme } from '../../lib/notions';
import { coursParCode, cheminCours } from '../../lib/parcours';
import { groupeDuTheme } from '../../lib/groupes';

export async function getStaticPaths() {
  return THEMES.map((theme) => ({ params: { theme: theme.code }, props: { theme } }));
}

const { theme } = Astro.props;
const questions = await questionsDuTheme(theme.code);
const notions = notionsDuTheme(theme.code);

// Le thème se lit notion par notion : c'est l'ordre dans lequel on l'apprend,
// pas celui dans lequel les questions ont été écrites. Une notion sans question
// garde sa place et son résumé, elle reste une étape de la révision.
const etapes = notions.map((notion) => ({
  notion,
  questions: questions.filter((q) => q.notion === notion.code),
}));

// Une question sans notion n'est pas perdue de vue : elle est ramassée en fin
// de page tant que la banque n'est pas entièrement reclassée.
const orphelines = questions.filter((q) => !q.notion);
const cours = coursParCode(theme.code);
const groupe = groupeDuTheme(theme.code);
---

<Base
  titre={theme.nom}
  description={`${theme.description.slice(0, 150)}`}
  miettes={[
    { nom: 'Programme', chemin: '/themes' },
    { nom: theme.nom, chemin: `/theme/${theme.code}` },
  ]}
>
  <div class="page page--etroite" style={POUR_APP ? undefined : 'padding-block:3rem 0'}>
    <p class="chapitre web-seulement"><a href="/themes">Programme</a></p>
    <h1>{theme.nom}</h1>
    <p class="meta">
      {groupe && <span class={`etiquette etiquette--${groupe.couleur}`}>{groupe.nom}</span>}
      <span class="intitule">{theme.intitule}</span>
    </p>
    <p class="chapo web-seulement">{theme.description}</p>

    {questions.length > 0 ? (
      <p style="margin-top:2rem">
        <a
          class="bouton bouton--principal"
          href={`/entrainement/${theme.code}`}
          data-mesure="theme-entrainement"
          data-mesure-theme={theme.code}
        >
          S’entraîner sur ce thème
        </a>
      </p>
    ) : (
      <div class="encadre" style="margin-top:2rem">
        <p style="margin:0"><strong>Pas encore de question publiée sur ce thème.</strong></p>
        <p class="discret" style="margin:0.4rem 0 0">
          Le plan de révision ci-dessous dit ce qu’il faut savoir. En attendant les
          questions, l’examen blanc tire dans les thèmes déjà écrits.
        </p>
      </div>
    )}
  </div>

  <div class="page page--etroite" style="margin-top:3.5rem">
    <h2>Ce qu’il faut savoir</h2>
    <p class="discret web-seulement">
      {notions.length} notion{notions.length > 1 ? 's' : ''} à réviser, dans l’ordre.
      {questions.length > 0 && ' Les questions de la banque sont rangées dessous.'}
    </p>

    {cours && (
      <p class="discret">
        Pour apprendre plutôt que réviser, ce thème a son cours,
        « <a href={cheminCours(cours.code)} data-mesure="theme-cours" data-mesure-theme={theme.code}>{cours.titre}</a> »,
        une leçon par notion, dans cet ordre.
      </p>
    )}

    <ol class="notions">
      {etapes.map(({ notion, questions: qs }) => (
        <li class="notion" id={notion.code}>
          <h3><a href={`/notion/${notion.code}`}>{notion.nom}</a></h3>
          <p class="resume">{notion.resume}</p>
          {qs.length > 0 ? (
            <ul class="questions">
              {qs.map((q) => (
                <li>
                  {POUR_APP ? <LienQuestion id={q.id} enonce={q.enonce} /> : <a href={`/question/${q.id}`}>{q.enonce}</a>}
                  <span class="discret">
                    {' '}· {q.sources.map((s) => s.texte).join(', ')}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="discret aucune">Aucune question sur cette notion pour l’instant.</p>
          )}
        </li>
      ))}
    </ol>

    {orphelines.length > 0 && (
      <div style="margin-top:2.5rem">
        <h3>Questions pas encore rattachées à une notion</h3>
        <ul class="questions">
          {orphelines.map((q) => (
            <li>{POUR_APP ? <LienQuestion id={q.id} enonce={q.enonce} /> : <a href={`/question/${q.id}`}>{q.enonce}</a>}</li>
          ))}
        </ul>
      </div>
    )}
  </div>
</Base>

<style>
  /* Le groupe se lit sous le titre, avec l'intitulé de l'arrêté en légende. */
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; margin: -0.25rem 0 1.25rem; }
  .intitule { color: var(--texte-doux); font-size: 0.8125rem; line-height: 1.45; }
  .chapo { color: var(--texte-doux); font-size: 1.25rem; line-height: 1.45; max-width: 34rem; }

  .notions { list-style: none; padding: 0; margin-top: 1.5rem; counter-reset: notion; }
  .notion { padding: 1.25rem 0; border-top: 1px solid var(--filet); max-width: none; }
  .notion:last-child { border-bottom: 1px solid var(--filet); }
  .notion h3 {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
    counter-increment: notion;
  }
  .notion h3::before {
    content: counter(notion);
    flex: 0 0 1.5rem;
    color: var(--texte-doux);
    font-size: 0.875rem;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
  .notion h3 a { color: inherit; text-decoration: none; }
  @media (hover: hover) and (pointer: fine) {
    .notion h3 a:hover { text-decoration: underline; }
  }
  .resume { margin: 0 0 0.6rem; padding-left: 2.25rem; }
  .aucune { margin: 0; padding-left: 2.25rem; font-style: italic; }

  .questions { padding-left: 3.5rem; margin: 0; }
  .questions li { margin-bottom: 0.45rem; }
  .questions a { color: inherit; text-decoration: none; }
  @media (hover: hover) and (pointer: fine) {
    .questions a:hover { text-decoration: underline; }
  }
</style>
