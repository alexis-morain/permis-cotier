---
import Base from '../layouts/Base.astro';
import { POUR_APP } from '../lib/cible';
import { themesAvecComptes } from '../lib/banque';
import { lignesProgramme } from '../lib/programme';

const lignes = lignesProgramme(await themesAvecComptes());
---

<Base
  titre="Le programme du permis côtier, thème par thème"
  description="Les quatorze thèmes de l’épreuve théorique du permis plaisance option côtière, dans l’ordre de l’arrêté du 28 septembre 2007."
  miettes={[{ nom: 'Programme', chemin: '/themes' }]}
>
  <div class="page" style={POUR_APP ? undefined : 'padding-block:3rem 1rem'}>
    <h1>Les quatorze thèmes de l’épreuve</h1>
    <p class="web-seulement">
      L’arrêté du 28 septembre 2007 fixe le programme à son article 1er, paragraphe 1.2.
      Il ne dit rien du nombre de questions par thème : la répartition ci-dessous est notre
      estimation, ajustée avec ce que remontent les candidats.
    </p>
  </div>

  <div class="page">
    {/* Une vue de base, comme une base Notion : une rangée par thème, des
        filets, un lavis au survol. Le groupe passe sous le nom sur un
        téléphone, où quatre colonnes ne tiennent pas. */}
    <div class="programme">
      <table class="base">
        <thead>
          <tr>
            <th scope="col">Thème</th>
            <th scope="col" class="base__groupe">Groupe</th>
            <th scope="col" class="base__nombre">Questions</th>
            <th scope="col" class="base__nombre base__cible">Cible</th>
          </tr>
        </thead>
        <tbody>
          {lignes.map((l) => (
            <tr>
              <th scope="row" class="base__nom">
                <a href={`/theme/${l.code}`}>{l.nom}</a>
                <span class="base__intitule">{l.intitule}</span>
                <span class={`etiquette etiquette--${l.groupe.couleur} base__groupe-court`}>{l.groupe.nom}</span>
              </th>
              <td class="base__groupe">
                <span class={`etiquette etiquette--${l.groupe.couleur}`}>{l.groupe.nom}</span>
              </td>
              <td class={`base__nombre${l.aVenir ? ' base__avenir' : ''}`}>{l.questions}</td>
              <td class="base__nombre base__cible">{l.cible}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  {/* La description de chaque thème est du contenu à part entière : elle reste
      dans la page, sous le tableau, lisible à la mesure. */}
  <section class="page couvre">
    <h2>Ce que couvre chaque thème</h2>
    <dl>
      {lignes.map((l) => (
        <div>
          <dt><a href={`/theme/${l.code}`}>{l.nom}</a></dt>
          <dd>{l.description}</dd>
        </div>
      ))}
    </dl>
  </section>
</Base>

<style>
  .programme { margin: 0 0 3rem; }

  .base { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .base th, .base td {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--filet);
    text-align: left;
    vertical-align: middle;
  }
  .base th:first-child, .base td:first-child { padding-left: 0; }
  .base th:last-child, .base td:last-child { padding-right: 0; }
  .base thead th {
    padding-block: 0.5rem;
    color: var(--texte-doux);
    font-size: 0.8125rem;
    font-weight: 400;
  }
  .base tbody th { font-weight: 400; }
  @media (hover: hover) and (pointer: fine) {
    .base tbody tr:hover > * { background: var(--fond-2); }
  }

  .base__nom a {
    display: block;
    color: inherit;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .base__nom a:hover { text-decoration: underline; }
  }
  .base__intitule { display: block; color: var(--texte-doux); font-size: 0.8125rem; line-height: 1.45; }
  .base__groupe-court { display: none; margin-top: 0.375rem; }

  .base__nombre { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .base thead .base__nombre { text-align: right; }
  .base__avenir { color: var(--texte-doux); }

  /* Sous 40 rem : le groupe vient sous le nom, la cible s'efface (elle est
     une estimation de répartition, pas ce qu'on cherche sur un téléphone). */
  @media (max-width: 39.99rem) {
    .base__groupe, .base__cible { display: none; }
    .base__groupe-court { display: inline-flex; white-space: normal; }
  }

  .couvre { margin-bottom: 4.5rem; }
  .couvre dl { margin: 0; }
  .couvre dl > div { padding: 1rem 0; border-top: 1px solid var(--filet); }
  .couvre dl > div:last-child { border-bottom: 1px solid var(--filet); }
  .couvre dt { margin-bottom: 0.25rem; font-weight: 600; }
  .couvre dt a { color: inherit; text-decoration: none; }
  @media (hover: hover) and (pointer: fine) {
    .couvre dt a:hover { text-decoration: underline; }
  }
  .couvre dd { margin: 0; color: var(--texte); max-width: var(--mesure); }
</style>
