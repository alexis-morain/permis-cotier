---
import Base from '../layouts/Base.astro';
import { themesAvecComptes } from '../lib/banque';

const themes = await themesAvecComptes();
---

<Base
  titre="Le programme du permis côtier, thème par thème"
  description="Les quatorze thèmes de l’épreuve théorique du permis plaisance option côtière, dans l’ordre de l’arrêté du 28 septembre 2007."
  miettes={[{ nom: 'Programme', chemin: '/themes' }]}
>
  <div class="page page--etroite" style="padding-block:3rem 1rem">
    <p class="chapitre">Programme</p>
    <h1>Les quatorze thèmes de l’épreuve</h1>
    <p>
      L’arrêté du 28 septembre 2007 fixe le programme à son article 1er, paragraphe 1.2.
      Il ne dit rien du nombre de questions par thème : la répartition ci-dessous est notre
      estimation, ajustée avec ce que remontent les candidats.
    </p>
  </div>

  <div class="page">
    <ul class="grilleThemes">
      {themes.map((t) => (
        <li>
          <h2><a href={`/theme/${t.code}`}>{t.nom}</a></h2>
          <p class="discret grilleThemes__intitule">{t.intitule}</p>
          <p>{t.description}</p>
          <p class="discret">
            {t.publiees > 0
              ? `${t.publiees} question${t.publiees > 1 ? 's' : ''} publiée${t.publiees > 1 ? 's' : ''}, cible ${t.cibleJ1}.`
              : `Aucune question publiée pour l’instant, cible ${t.cibleJ1}.`}
          </p>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .grilleThemes { list-style: none; margin: 0 0 3rem; padding: 0; }
  .grilleThemes li { border-top: 1px solid var(--filet); padding: 1.75rem 0; }
  .grilleThemes h2 { font-size: 1.5rem; margin-bottom: 0.15rem; }
  .grilleThemes h2 a { text-decoration: none; }
  .grilleThemes h2 a:hover { text-decoration: underline; text-decoration-color: var(--accent); }
  .grilleThemes__intitule { margin-bottom: 0.75rem; }
  @media (min-width: 60rem) {
    .grilleThemes li {
      display: grid;
      grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
      gap: 0 3rem;
    }
    .grilleThemes li > h2 { grid-row: 1; margin: 0; }
    .grilleThemes li > .grilleThemes__intitule { grid-column: 1; }
    .grilleThemes li > p:not(.grilleThemes__intitule) { grid-column: 2; }
    .grilleThemes li > p:nth-of-type(2) { grid-row: 1 / span 2; }
  }
</style>
