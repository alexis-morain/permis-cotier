---
import { NOM_PROVENANCE, type Provenance } from '../lib/sources';
import { POUR_APP } from '../lib/cible';

/**
 * Ce qu'est une source citée, dit à côté d'elle.
 *
 * Un texte officiel se lit ailleurs, sur Légifrance ou sur le site d'un préfet
 * maritime ; une fiche du site se lit ici, parce qu'elle n'existe nulle part
 * ailleurs. Les deux liens se ressemblent, la marque les sépare.
 */
interface Props {
  provenance: Provenance;
}

const { provenance } = Astro.props;
// Dans l'app, la fiche n'est pas « du site » : c'est une fiche maison.
const nom = POUR_APP && provenance === 'fiche' ? 'Fiche maison' : NOM_PROVENANCE[provenance];
---

<span class={`marque marque--${provenance}`}>{nom}</span>

<style>
  /* Pas de couleur : les quatre couleurs pâles disent un groupe de thèmes, et
     une marque de source n'en est pas un. C'est le bord qui appuie la fiche. */
  .marque {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--filet);
    border-radius: var(--rayon-etiquette);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--texte-doux);
    white-space: nowrap;
    vertical-align: 0.1em;
  }
  .marque--fiche {
    border-color: var(--filet-fort);
    color: var(--texte);
  }
</style>
