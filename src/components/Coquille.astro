---
/**
 * Ce que la tête de page ne porte que dans la coquille iOS.
 *
 * `Base.astro` ne rend ce composant que sous `POUR_APP`. Ça ne suffit pas à
 * garder le site intact : Astro empaquette les scripts de tout composant
 * importé, rendu ou non.
 *
 * - `<ClientRouter />` : une navigation remplace le corps de la page sans la
 *   recharger. Plus de flash blanc entre deux écrans, et `<main>` glisse.
 *   Astro coupe lui-même l'animation sous `prefers-reduced-motion`.
 * - Les liens vers un autre site s'ouvrent dans Safari intégré.
 * - La barre d'état suit le fond de la page.
 * - Une racine d'onglet se recharge quand la progression a changé ailleurs.
 *
 * D'où le greffon de `astro.config.mjs` : hors de la cible « app », il
 * remplace ce fichier par un composant vide, et ni le routeur ni les
 * écouteurs ci-dessous n'entrent dans le site.
 */
import { ClientRouter } from 'astro:transitions';
---

<ClientRouter />

<script>
  import { ouvrirDehors } from '../lib/natif';
  import { accorderBarreEtatALaPage } from '../lib/apparence';
  import { rafraichirSiLaProgressionAChange } from '../lib/page';

  // Un script de module ne s'exécute qu'une fois par document, et le routeur
  // garde le document d'un écran à l'autre : les deux écouteurs ci-dessous
  // sont posés une seule fois, pour toute la vie de l'onglet.

  document.addEventListener('click', (clic) => {
    if (clic.defaultPrevented || clic.button !== 0) return;
    if (clic.metaKey || clic.ctrlKey || clic.shiftKey || clic.altKey) return;
    const cible = clic.target;
    if (!(cible instanceof Element)) return;
    const lien = cible.closest('a[href]');
    if (!(lien instanceof HTMLAnchorElement)) return;

    // `mailto:` et `tel:` ont une origine « null » : ils restent au système,
    // qui sait les ouvrir. Seul le web d'un autre part dans Safari intégré.
    const url = new URL(lien.href, location.href);
    if (url.protocol !== 'https:' && url.protocol !== 'http:') return;
    if (url.origin === location.origin) return;

    clic.preventDefault();
    void ouvrirDehors(url.href).then((ouvert) => {
      if (!ouvert) window.open(url.href, '_blank', 'noopener');
    });
  });

  // Le bouton Retour remonte d'un échelon : l'écran doit glisser vers la
  // droite, comme le retour d'iOS. Pour le routeur c'est un lien suivi, donc
  // une navigation en avant ; on lui dit le sens, qui ne touche que
  // l'animation, pas l'historique.
  document.addEventListener('astro:before-preparation', (evenement) => {
    if (evenement.sourceElement?.closest('.retour__lien, .lecon__chapitre a')) {
      evenement.direction = 'back';
    }
  });

  // WebKit n'applique `:active` au toucher que si la page écoute
  // `touchstart`. Sans cet écouteur vide, ni les boutons ni les cellules ne
  // s'enfoncent sous le doigt.
  document.addEventListener('touchstart', () => {}, { passive: true });

  // Une leçon pose la classe `js` sur <html> avant son îlot, pour autoriser
  // le pas à pas. Le routeur remplace les attributs de <html> à chaque
  // navigation : la classe tombe en quittant une leçon, et doit revenir à
  // chaque leçon, quel que soit le chemin pris pour y arriver.
  document.addEventListener('astro:page-load', () => {
    if (document.querySelector('.lecon')) document.documentElement.classList.add('js');
  });

  // Un onglet qui revient à l'écran relit la progression écrite ailleurs.
  rafraichirSiLaProgressionAChange();

  void accorderBarreEtatALaPage();
  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => void accorderBarreEtatALaPage());
</script>
