# En-têtes servis par Cloudflare Workers Static Assets.
#
# Le www ne se redirige pas ici : `_redirects` matche sur le chemin et ignore
# l'hôte. La redirection de www vers le domaine nu est une Redirect Rule de la
# zone, posée dans le tableau de bord Cloudflare.

# Le HTML n'est pas figé : la banque change à chaque publication, et une page
# gardée trop longtemps en cache montre un compte de questions périmé.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: public, max-age=0, must-revalidate

# Les visuels portent leur contenu dans leur nom : ils peuvent être gardés.
/visuels/*
  Cache-Control: public, max-age=31536000, immutable

/partage/*
  Cache-Control: public, max-age=86400

# La banque, sortie du HTML. Le nom porte la version : le fichier ne change
# jamais sous ce nom-là, il se garde donc pour de bon. `derniere.json`, lui,
# est le seul point qui doive dire la vérité du jour — c'est ce que l'app iOS
# interroge au lancement pour savoir si sa banque a vieilli.
/banque/*
  Cache-Control: public, max-age=31536000, immutable

/banque/derniere.json
  Cache-Control: public, max-age=300, must-revalidate

# Les fichiers que les robots relisent souvent, sans les figer.
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
/sitemap-index.xml
  Cache-Control: public, max-age=3600
/sitemap-0.xml
  Cache-Control: public, max-age=3600
