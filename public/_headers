# Le HTML n'est pas figé : la banque change à chaque publication, et une page
# gardée trop longtemps en cache montre un compte de questions périmé.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: public, max-age=0, must-revalidate

# Les visuels portent leur contenu dans leur nom : ils peuvent être gardés.
/visuels/*
  Cache-Control: public, max-age=31536000, immutable

/partage/*
  Cache-Control: public, max-age=86400

# Les fichiers que les robots relisent souvent, sans les figer.
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
/sitemap-index.xml
  Cache-Control: public, max-age=3600
/sitemap-0.xml
  Cache-Control: public, max-age=3600
