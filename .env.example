# Copie ce fichier en .env et remplis les valeurs.
# Référence maître : ~/Documents/08_IA/02_Outputs/permis-cotier/.env (Bitwarden dev-env)

# API Légifrance via PISTE (https://piste.gouv.fr), fonds LODA
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=

# Compte robot GitHub qui crée les issues de signalement (scope issues seul)
GITHUB_BOT_TOKEN=
GITHUB_REPO=

# Resend, mail de notification des signalements
RESEND_API_KEY=
SIGNALEMENT_MAIL_TO=

# Cloudflare Turnstile (anti-spam du formulaire)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Umami (identifiant du site, pas un secret)
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=
