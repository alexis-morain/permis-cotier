# Copie ce fichier en .env et remplis les valeurs.
# Référence maître : ~/Documents/08_IA/02_Outputs/permis-cotier/.env (Bitwarden dev-env)

# API Légifrance via PISTE (https://piste.gouv.fr), fonds LODA
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=

# Signalement d'erreur — `src/worker.ts`, endpoint `POST /api/signaler`.
#
# Ces valeurs-là ne servent qu'au développement local (`wrangler dev` les lit
# depuis `.dev.vars`). En ligne, ce sont des secrets de Worker, posés un par un
# par `wrangler secret put <NOM>` : ils n'entrent jamais dans le dépôt, ni dans
# `wrangler.toml`. Seule `TURNSTILE_SITE_KEY` est publique et entre au build.

# Jeton GitHub à portée fine, `Issues: Read and write` sur alexis-morain/permis-cotier
# et rien d'autre. C'est lui qui ouvre l'issue publique du signalement.
GITHUB_BOT_TOKEN=
GITHUB_REPO=alexis-morain/permis-cotier

# Resend, notification par courrier en plus de l'issue. Entièrement facultatif :
# sans clé, l'endpoint marche pareil. Le domaine de `FROM` doit être vérifié
# chez Resend.
RESEND_API_KEY=
SIGNALEMENT_MAIL_TO=
SIGNALEMENT_MAIL_FROM=

# Cloudflare Turnstile (anti-robot du formulaire). Sans `TURNSTILE_SECRET_KEY`,
# l'endpoint rend 503 et la page retombe sur le `mailto:` : on n'accepte jamais
# un envoi non vérifié.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Umami (identifiant du site, pas un secret)
# Les deux valeurs de production sont en dur dans `src/lib/mesure.ts`, pour que
# le build de Cloudflare, qui n'a pas ce fichier, produise un site mesuré. Ces
# variables ne servent qu'à pointer une autre instance, le temps d'un essai.
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=
